flowchart LR
    subgraph stock["問題：venvにcolconなし"]
        direction TB
        S1["colcon build<br/>→ /usr/bin/colcon"]
        S2["system Pythonで<br/>colcon → setup.py"]
        S3["生成スクリプトのシバン<br/>#!/usr/bin/python3"]
        S4["ノード：system Python<br/>venv専用依存のimport失敗"]
        S1 -->|"colconのシバン"| S2
        S2 -->|"setuptoolsが生成"| S3
        S3 -->|"ros2 run / launch"| S4
    end

    subgraph aptvenv["方式A：apt版colconを使う"]
        direction TB
        A1[".venv/bin/python<br/>-m colcon build"]
        A2["venv Pythonで<br/>apt版colcon → setup.py"]
        A3["生成スクリプトのシバン<br/>#!/ws/.venv/bin/python"]
        A4["ノード：venv Python<br/>venv専用依存のimport成功"]
        A1 -->|"Pythonを明示"| A2
        A2 -->|"setuptoolsが生成"| A3
        A3 -->|"ros2 run / launch"| A4
    end

    subgraph venvcolcon["方式B：venv版colconを使う"]
        direction TB
        B1["colcon build<br/>→ .venv/bin/colcon"]
        B2["venv Pythonで<br/>venv版colcon → setup.py"]
        B3["生成スクリプトのシバン<br/>#!/ws/.venv/bin/python3"]
        B4["ノード：venv Python<br/>venv専用依存のimport成功"]
        B1 -->|"colconのシバン"| B2
        B2 -->|"setuptoolsが生成"| B3
        B3 -->|"ros2 run / launch"| B4
    end

    stock ~~~ aptvenv ~~~ venvcolcon

